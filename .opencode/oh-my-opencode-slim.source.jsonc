        "mcps": []
      },
      "e2e-validator": {
        "model": "opencode-go/deepseek-v4-flash",
        "temperature": 0.1,
        "skills": [],
        "mcps": [
          "playwright"
        ]
      },
      "integration-validator": {
        "model": "opencode-go/deepseek-v4-flash",
        "temperature": 0.1,
