  },
  // UI multiplexer settings
  "multiplexer": {
    "type": "auto",
    "layout": "tiled",
    "main_pane_size": 55
  },
  // Council settings
  "council": {
    "default_preset": "default",
    "timeout": 180000,
    "councillor_execution_mode": "parallel",
    "councillor_retries": 2,
    "presets": {
      "default": {
        "alpha": {
          "model": "opencode-go/qwen3.6-plus",
          "variant": "medium"
        },
        "beta": {
          "model": "opencode-go/glm-5.1",
          "variant": "medium"
        },
        "gamma": {
          "model": "openai/gpt-5.4-mini",
          "variant": "medium"
        }
      },
      // Intentionally available for manual/on-demand use only; not used by default runtime routing.
      "deep-review": {
        "alpha": {
          "model": "openai/gpt-5.5",
          "variant": "high"
        },
        "beta": {
          "model": "opencode-go/glm-5.1",
          "variant": "high"
        },
        "gamma": {
          "model": "opencode-go/kimi-k2.5",
          "variant": "high"
        }
      }
    }
  },
  // Fallback chains
  "fallback": {
    "enabled": true,
    "timeoutMs": 20000,
    "retryDelayMs": 500,
    "retry_on_empty": true
  },
  // Todo continuation settings
  "todoContinuation": {
    "maxContinuations": 10,
    "cooldownMs": 2500,
    "autoEnable": true,
    "autoEnableThreshold": 4
  }
}
