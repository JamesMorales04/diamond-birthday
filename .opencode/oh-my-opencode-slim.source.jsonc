        "temperature": 0.1,
        "skills": [
          "frontend-implementation-checklist"
        ],
        "mcps": [
          "grep_app",
          "context7"
        ]
      },
      "test-implementer": {
        "model": "opencode-go/deepseek-v4-flash",
        "temperature": 0.1,
        "skills": [
          "test-implementation-checklist",
          "acceptance-traceability-auditor"
        ],
        "mcps": [
          "grep_app",
          "context7"
        ]
      },
      "docs-implementer": {
        "model": "opencode-go/deepseek-v4-flash",
        "temperature": 0.1,
        "skills": [
          "docs-implementation-checklist",
          "prompt-drift-auditor",
          "config-policy-audit"
        ],
        "mcps": [
          "grep_app",
          "context7"
        ]
      },
      "ops-implementer": {
        "model": "opencode-go/deepseek-v4-flash",
        "temperature": 0.1,
        "skills": [
          "ops-implementation-checklist",
          "git-delivery-lifecycle-checklist",
          "dependency-supply-chain-checklist",
          "prompt-drift-auditor"
        ],
        "mcps": [
