# Vite base path for production builds
# ---------------------------------------------------------------
# Set this to the sub-path where the app is served.
#
# For GitHub Pages repository sites (repo-name):
#   VITE_BASE_PATH=/diamond-birthday/
#
# For custom domains or local development:
#   Leave unset or set to /
# ---------------------------------------------------------------
# Usage:
#   VITE_BASE_PATH=/diamond-birthday/ pnpm build
#
# For local dev:
#   pnpm dev                     # uses default /
VITE_BASE_PATH=/
